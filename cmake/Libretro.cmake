cmake_minimum_required(VERSION 3.13)
# Frontend-driven cores: intentionally no standalone/platform main, SDL or SDK.
if(ADHOC OR COMMAND_LIST OR SAVE_STATE OR LARGE_MEMORY OR KERNEL_MODE)
  message(FATAL_ERROR "LIBRETRO does not support ADHOC, COMMAND_LIST, SAVE_STATE, LARGE_MEMORY or KERNEL_MODE")
endif()
set(CMAKE_C_STANDARD 99)
set(CMAKE_C_EXTENSIONS ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
string(TOLOWER "${TARGET}" target_lower)
set(core njemu_${target_lower}_libretro)
set(src
  src/libretro/core.c src/libretro/runtime.c src/libretro/video.c
  src/libretro/audio.c src/libretro/input.c src/libretro/ui.c
  src/desktop/desktop_ui_text.c src/common/ui_text_driver.c
  src/common/filer.c src/common/loadrom.c src/common/cache.c
  src/zip/zfile.c src/zip/unzip.c src/sound/sndintrf.c
  src/cpu/m68000/m68000.c src/cpu/m68000/c68k.c
  src/cpu/z80/z80.c src/cpu/z80/cz80.c
  src/${target_lower}/${target_lower}.c src/${target_lower}/driver.c
  src/${target_lower}/memintrf.c src/${target_lower}/inptport.c
  src/${target_lower}/timer.c src/${target_lower}/vidhrdw.c
  src/${target_lower}/sprite_common.c src/${target_lower}/desktop_sprite.c)
if("${TARGET}" MATCHES "^CPS[12]$")
  list(APPEND src src/common/coin.c src/${target_lower}/eeprom.c src/sound/qsound.c)
  if("${TARGET}" STREQUAL "CPS1")
    list(APPEND src src/cps1/dipsw.c src/cps1/kabuki.c src/sound/2151intf.c src/sound/ym2151.c)
  else()
    list(APPEND src src/cps2/cps2crpt.c)
  endif()
else()
  list(APPEND src src/sound/2610intf.c src/sound/ym2610.c)
  if("${TARGET}" STREQUAL "MVS")
    list(APPEND src src/mvs/dipsw.c src/mvs/pd4990a.c src/mvs/neocrypt.c src/mvs/biosmenu.c)
  else()
    list(APPEND src src/ncdz/cdda.c src/ncdz/cdrom.c src/ncdz/startup.c src/libretro/mp3.c)
  endif()
endif()
add_library(${core} SHARED ${src})
set_target_properties(${core} PROPERTIES PREFIX "" C_VISIBILITY_PRESET hidden)
target_include_directories(${core} PRIVATE src src/zip src/${target_lower})
target_compile_definitions(${core} PRIVATE NO_GUI RELEASE=0 VERSION_MAJOR=2 VERSION_MINOR=4 VERSION_BUILD=0 VERSION_STR="2.4" TARGET_STR="${TARGET}" _DEFAULT_SOURCE)
# The legacy CPU cores alias word and byte accesses to emulated memory.
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
  target_compile_options(${core} PRIVATE -fno-strict-aliasing -Wno-implicit-int -Wno-implicit-function-declaration -Wno-int-conversion)
  if(NOT APPLE)
    target_link_options(${core} PRIVATE -Wl,--no-undefined)
  endif()
endif()
find_package(ZLIB REQUIRED)
target_link_libraries(${core} PRIVATE ZLIB::ZLIB)
if(NOT WIN32)
  target_link_libraries(${core} PRIVATE m)
endif()
option(USE_ASAN "Address and undefined behavior sanitizers" OFF)
if(USE_ASAN)
  target_compile_options(${core} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
  target_link_options(${core} PRIVATE -fsanitize=address,undefined)
endif()
include(CTest)
if(BUILD_TESTING AND UNIX)
  add_executable(libretro_host tests/libretro/host.c)
  target_include_directories(libretro_host PRIVATE src/libretro)
  target_link_libraries(libretro_host PRIVATE ${CMAKE_DL_LIBS} m)
  if(USE_ASAN)
    target_compile_options(libretro_host PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(libretro_host PRIVATE -fsanitize=address,undefined)
  endif()
  add_executable(libretro_video_test tests/libretro/video.c src/libretro/video.c)
  target_include_directories(libretro_video_test PRIVATE src src/zip src/${target_lower})
  target_compile_definitions(libretro_video_test PRIVATE NO_GUI RELEASE=0)
  if(USE_ASAN)
    target_compile_options(libretro_video_test PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(libretro_video_test PRIVATE -fsanitize=address,undefined)
  endif()
  if("${TARGET}" STREQUAL "CPS2" AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang" AND NOT APPLE)
    add_executable(libretro_cps2_gfx_test tests/libretro/cps2_gfx.c src/cps2/vidhrdw.c)
    target_include_directories(libretro_cps2_gfx_test PRIVATE src src/zip src/cps2)
    target_compile_definitions(libretro_cps2_gfx_test PRIVATE NO_GUI RELEASE=0)
    target_compile_options(libretro_cps2_gfx_test PRIVATE -ffunction-sections -fdata-sections -fno-strict-aliasing)
    target_link_options(libretro_cps2_gfx_test PRIVATE -Wl,--gc-sections)
    if(USE_ASAN)
      target_compile_options(libretro_cps2_gfx_test PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
      target_link_options(libretro_cps2_gfx_test PRIVATE -fsanitize=address,undefined)
    endif()
    add_test(NAME graphics_decode COMMAND libretro_cps2_gfx_test)
  endif()
  add_test(NAME video COMMAND libretro_video_test)
  add_test(NAME lifecycle COMMAND libretro_host $<TARGET_FILE:${core}> ${CMAKE_SOURCE_DIR}/resources/${target_lower})
  if("${TARGET}" MATCHES "^(CPS[12]|NCDZ)$")
    find_package(Python3 COMPONENTS Interpreter QUIET)
    if(Python3_FOUND)
      execute_process(COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tests/libretro/make_fixture.py ${CMAKE_BINARY_DIR}/libretro_fixture RESULT_VARIABLE fixture_result OUTPUT_QUIET)
      if(NOT fixture_result EQUAL 0)
        message(FATAL_ERROR "Could not generate original CPU test fixture")
      endif()
      if("${TARGET}" STREQUAL "CPS1")
        add_test(NAME frames COMMAND libretro_host $<TARGET_FILE:${core}> ${CMAKE_BINARY_DIR}/libretro_fixture ${CMAKE_BINARY_DIR}/libretro_fixture/1941.zip)
        add_test(NAME parent_clone COMMAND libretro_host $<TARGET_FILE:${core}> ${CMAKE_BINARY_DIR}/libretro_fixture ${CMAKE_BINARY_DIR}/libretro_fixture/1941j.zip)
      elseif("${TARGET}" STREQUAL "CPS2")
        add_test(NAME frames COMMAND libretro_host $<TARGET_FILE:${core}> ${CMAKE_BINARY_DIR}/libretro_fixture/cps2_direct ${CMAKE_BINARY_DIR}/libretro_fixture/cps2_direct/lrtest.zip)
        add_test(NAME byte_lanes COMMAND libretro_host $<TARGET_FILE:${core}> ${CMAKE_BINARY_DIR}/libretro_fixture/cps2_byte_lanes ${CMAKE_BINARY_DIR}/libretro_fixture/cps2_byte_lanes/lrtest.zip)
        foreach(failure missing_parent invalid_graphics invalid_offset corrupt_graphics short_graphics)
          add_test(NAME ${failure} COMMAND libretro_host $<TARGET_FILE:${core}> ${CMAKE_BINARY_DIR}/libretro_fixture/cps2_${failure} ${CMAKE_BINARY_DIR}/libretro_fixture/cps2_${failure}/lrtest.zip reject)
        endforeach()
      elseif("${TARGET}" STREQUAL "NCDZ" AND EXISTS "${CMAKE_BINARY_DIR}/libretro_fixture/tone.mp3")
        add_executable(libretro_cdda_test tests/libretro/cdda.c src/libretro/mp3.c)
        target_include_directories(libretro_cdda_test PRIVATE src src/zip src/ncdz)
        target_compile_definitions(libretro_cdda_test PRIVATE NO_GUI RELEASE=0)
        if(USE_ASAN)
          target_compile_options(libretro_cdda_test PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
          target_link_options(libretro_cdda_test PRIVATE -fsanitize=address,undefined)
        endif()
        add_test(NAME cdda COMMAND libretro_cdda_test ${CMAKE_BINARY_DIR}/libretro_fixture/tone.mp3)
      endif()
    endif()
  endif()
endif()
install(TARGETS ${core} LIBRARY DESTINATION lib/libretro RUNTIME DESTINATION lib/libretro)
